PLATTER_ENV=development

# Use a unique random value in production; do not reuse the example.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Local development can use SQLite. Set your PostgreSQL URL when needed.
DATABASE_URL=sqlite:///platter.db

# Production serves all network interfaces by default. For development,
# use 127.0.0.1 unless intentionally testing from another machine.
PLATTER_HOST=127.0.0.1
PORT=5000

# Production defaults this to true. Set false only for HTTP on a trusted,
# isolated local network; use HTTPS for any untrusted network.
# SESSION_COOKIE_SECURE=false

# Set these only for the first production admin, or to rotate the seeded
# development admin password before production startup.
# ADMIN_USERNAME=admin
# ADMIN_FULL_NAME=Restaurant Administrator
# ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters

MPESA_ENV=sandbox
MPESA_TILL=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=
